{
    "name": "jooservices/laravel-config",
    "version": "1.0.0",
    "description": "Store and retrieve application configuration in database (MongoDB) with caching.",
    "keywords": ["laravel", "config", "mongodb", "configuration"],
    "license": "MIT",
    "authors": [
        {
            "name": "Viet Vu",
            "email": "jooservices@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/cache": "^11.0|^12.0",
        "illuminate/config": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "mongodb/laravel-mongodb": "^4.0|^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^12.0",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpmd/phpmd": "^2.13",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "JooServices\\LaravelConfig\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JooServices\\LaravelConfig\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text",
        "lint": [
            "@lint:pint",
            "@lint:phpstan",
            "@lint:phpmd",
            "@lint:phpcs"
        ],
        "lint:fix": "vendor/bin/pint",
        "lint:pint": "vendor/bin/pint",
        "lint:phpstan": "vendor/bin/phpstan analyse --memory-limit=256M",
        "lint:phpmd": "vendor/bin/phpmd src text phpmd.xml",
        "lint:phpcs": "vendor/bin/phpcs src tests --standard=phpcs.xml"
    },
    "extra": {
        "laravel": {
            "providers": [
                "JooServices\\LaravelConfig\\ConfigServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
