<?xml version="1.0"?>
<ruleset name="JOOservices Laravel Config">
    <description>PHP_CodeSniffer rules. Pint has priority over PHPCS on formatting.</description>
    <rule ref="PSR12"/>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
        </properties>
    </rule>
    <!-- Pint: no space around concatenation operator -->
    <rule ref="PSR12.Operators.OperatorSpacing">
        <exclude name="PSR12.Operators.OperatorSpacing.NoSpaceBefore"/>
        <exclude name="PSR12.Operators.OperatorSpacing.NoSpaceAfter"/>
    </rule>
    <!-- Pint wins for empty single-line constructor bodies -->
    <rule ref="Squiz.WhiteSpace.ScopeClosingBrace.ContentBefore">
        <exclude-pattern>*/src/Support/ConfigPath.php</exclude-pattern>
        <exclude-pattern>*/src/Services/ConfigService.php</exclude-pattern>
        <exclude-pattern>*/src/Events/*</exclude-pattern>
    </rule>
    <!-- PHPUnit test methods use test_method_name_with_underscores -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <file>src</file>
    <file>tests</file>
    <arg value="sp"/>
    <arg name="colors"/>
</ruleset>
